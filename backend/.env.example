# Copy to .env and fill in. .env is gitignored.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=./vectorstore
COLLECTION_NAME=hr_policy_chunks

# List price, USD per million tokens, from the provider's
# pricing page. Left unset the cost columns read 0.00, which
# is honest but useless.
INPUT_COST_PER_1M=0.25
OUTPUT_COST_PER_1M=2.00

# ---------------------------------------------------------
# LangSmith. Optional - the JSONL log in logs/requests.jsonl
# is the source of truth and needs none of this.
#
# Off unless LANGSMITH_ENABLED=1, because a client that cannot
# reach the service should never slow down or break a request.
# ---------------------------------------------------------

# LANGSMITH_ENABLED=1
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=hr360-bot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------
# Provider for the generator and the judge.
#
# Gemini Flash has a free tier (~1,500 requests/day, no card):
#   https://aistudio.google.com/apikey
#
# The Week-7 agent loop stays on OpenAI either way - it does
# tool calling, the providers disagree on the shape of a tool
# call, and the Week-8/10 numbers were measured against
# OpenAI's. It is replayed in every eval, so it needs no key.
# ---------------------------------------------------------

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash
