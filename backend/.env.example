# Copy to .env and fill in. .env is gitignored.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=./vectorstore
COLLECTION_NAME=hr_policy_chunks

# List price, USD per million tokens, from the provider's
# pricing page. Left unset the cost columns read 0.00, which
# is honest but useless.
INPUT_COST_PER_1M=0.25
OUTPUT_COST_PER_1M=2.00

# ---------------------------------------------------------
# LangSmith. Optional - the JSONL log in logs/requests.jsonl
# is the source of truth and needs none of this.
#
# Off unless LANGSMITH_ENABLED=1, because a client that cannot
# reach the service should never slow down or break a request.
# ---------------------------------------------------------

# LANGSMITH_ENABLED=1
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=hr360-bot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
